{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ports": {
    "Admin": 5100,
    "QuickVerify": 5101,
    "SureCheck": 5102,
    "TrustLink": 5103
  },
  "Behaviour": {
    "QuickVerify": {
      "FailureRate": 0.3,
      "SlowRate": 0.1,
      "NormalDelayMs": 150,
      "SlowDelayMs": 5000
    },
    "SureCheck": {
      "FailureRate": 0.0,
      "SlowRate": 0.0,
      "NormalDelayMs": 1500,
      "SlowDelayMs": 5000
    },
    "TrustLink": {
      "FailureRate": 0.1,
      "SlowRate": 0.0,
      "NormalDelayMs": 200,
      "SlowDelayMs": 5000
    }
  }
}
